#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

dir="${SPEC_DIR:-docs/product}"
cmd="${1:-status}"

case "$cmd" in
  status)
    if [ ! -d "$dir" ]; then
      echo "spec: нет $dir — канон ещё не заведён"
      exit 0
    fi
    bad=0
    found=0
    for f in "$dir"/*.md; do
      [ -e "$f" ] || continue
      name="$(basename "$f")"
      case "$name" in
        _формат.md|README.md|_слова.md) continue ;;
      esac
      found=$((found + 1))
      status="$(sed -n 's/^статус:[[:space:]]*//p' "$f" | head -1)"
      src="$(sed -n 's/^источник:[[:space:]]*//p' "$f" | head -1)"
      printf '%-38s %s\n' "$name" "${status:-нет статуса}"
      if [ -z "$src" ] || [ "$src" = "—" ]; then
        echo "  ! нет источник: $f" >&2
        bad=$((bad + 1))
      fi
    done
    [ "$found" -gt 0 ] || echo "spec: карточек пока нет ($dir)"
    [ "$bad" -eq 0 ]
    ;;
  diff)
    if [ -d .jj ]; then
      jj diff "$dir"
    elif [ -d .git ]; then
      git diff -- "$dir"
    else
      echo "spec: нет VCS" >&2
      exit 1
    fi
    ;;
  *)
    echo "usage: spec status|diff" >&2
    exit 2
    ;;
esac
